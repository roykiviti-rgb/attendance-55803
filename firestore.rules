rules_version = '2';

// כל הגישה ל-Firestore עוברת דרך ה-Cloudflare Worker בלבד (service account,
// שעוקף את הכללים האלה). כל קריאה או כתיבה ישירה מדפדפן נחסמת.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
